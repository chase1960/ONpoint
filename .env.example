# 复制为 .env 后填入自己的值；.env 已被 .gitignore 忽略，不要提交。
# 全部留空也能运行：不配密钥时，分诊走本地规则，JEV 层自动关闭。

# ── JEV 判定层（可选增强，不接也能跑）────────────────────────
# off / shadow / assist。shadow = 只记录不采用；assist = 过阈值才采用
JEV_MODE=off
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-1.14.0
TYPESAFE_TIMEOUT_MS=15000
# 只允许合成样例外发，避免真实用户文本离开本机
TYPESAFE_ALLOW_SYNTHETIC_EGRESS=true
# 可选：本机代理，仅作用于本客户端，不改系统代理
TYPESAFE_PROXY_URL=

# ── 对话模型（当前仅用于抽取与表达，业务对话仍走规则）──────────
LLM_MODE=off
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
